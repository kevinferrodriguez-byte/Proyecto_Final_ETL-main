		formatString: 0.0
		displayFolder: Referencias
		lineageTag: bbc01e17-0d01-5aec-9ae5-f954fc0f89e3

	measure 'Año base contributivo' = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "total_pensiones", ALLSELECTED(dim_tiempo))
		formatString: 0
		displayFolder: Índices
		lineageTag: 27c71d4d-7a03-5960-9298-1251c5782358

	measure 'Afiliados (índice)' = VAR a0 = [Año base contributivo] VAR base = CALCULATE([Afiliados a 31 de diciembre], REMOVEFILTERS(dim_tiempo), dim_tiempo[tiempo_key] = a0) RETURN IF(MAX(dim_tiempo[anyo]) >= a0, DIVIDE([Afiliados a 31 de diciembre], base) * 100)
		formatString: 0.0
		displayFolder: Índices
		lineageTag: 195bf1fa-60ca-5642-8ac5-f6ca5d98cd5f

	measure 'Pensiones (índice)' = VAR a0 = [Año base contributivo] VAR base = CALCULATE([Pensiones contributivas], REMOVEFILTERS(dim_tiempo), dim_tiempo[tiempo_key] = a0) RETURN IF(MAX(dim_tiempo[anyo]) >= a0, DIVIDE([Pensiones contributivas], base) * 100)
		formatString: 0.0
		displayFolder: Índices
		lineageTag: b8715a9f-22fb-559b-9d6c-f60d80482eda

	measure 'Base 100 (contributivo)' = IF(ISBLANK([Pensiones (índice)]), BLANK(), 100)
		formatString: 0
		displayFolder: Referencias
		lineageTag: 0f05069d-409c-5ecc-87e8-c47c270dca2a

	measure 'Año base financiero' = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "gasto_pensiones_pib", ALLSELECTED(dim_tiempo))
		formatString: 0
		displayFolder: Índices
		lineageTag: 15825c02-0079-5d23-80f5-5d47101be0e4

	measure 'Gasto en pensiones (índice)' = VAR a0 = [Año base financiero] VAR base = CALCULATE([Gasto en pensiones (M€)], REMOVEFILTERS(dim_tiempo), dim_tiempo[tiempo_key] = a0) RETURN IF(MAX(dim_tiempo[anyo]) >= a0, DIVIDE([Gasto en pensiones (M€)], base) * 100)
		formatString: 0.0
		displayFolder: Índices
		lineageTag: f8113627-6d30-5200-90fe-cb9c76ca233d

	measure 'PIB (índice)' = VAR a0 = [Año base financiero] VAR base = CALCULATE([PIB (M€)], REMOVEFILTERS(dim_tiempo), dim_tiempo[tiempo_key] = a0) RETURN IF(MAX(dim_tiempo[anyo]) >= a0 && NOT ISBLANK([Gasto en pensiones (M€)]), DIVIDE([PIB (M€)], base) * 100)
		formatString: 0.0
		displayFolder: Índices
		lineageTag: 761f982f-853b-5e51-9bcb-a1f778a93817

	measure 'Base 100 (financiero)' = IF(ISBLANK([PIB (índice)]), BLANK(), 100)
		formatString: 0
		displayFolder: Referencias
		lineageTag: e1735d78-0e2b-5af9-a076-08346633371e

	measure 'Año del último valor' = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_sexo[codigo_sexo] = "total", dim_grupo_edad[codigo_grupo] = "total")
		formatString: 0
		displayFolder: Contexto KPI
		lineageTag: ae1753fa-be75-55a0-bc6e-c1d915d8a416

	measure 'Último valor' = VAR a = [Año del último valor] RETURN CALCULATE([Valor observado], dim_tiempo[tiempo_key] = a, dim_sexo[codigo_sexo] = "total", dim_grupo_edad[codigo_grupo] = "total")
		formatString: #,0.00
		displayFolder: Contexto KPI
		lineageTag: c723b823-45af-50fd-a73b-2550121a26bc

	measure 'Valor año anterior' = VAR a = [Año del último valor] RETURN CALCULATE([Valor observado], dim_tiempo[tiempo_key] = a - 1, dim_sexo[codigo_sexo] = "total", dim_grupo_edad[codigo_grupo] = "total")
		formatString: #,0.00
		displayFolder: Contexto KPI
		lineageTag: 94306e3c-c736-5cd7-a937-e96ee2df840a

	measure 'Variación absoluta' = VAR v = [Último valor] VAR p = [Valor año anterior] RETURN IF(ISBLANK(v) || ISBLANK(p), BLANK(), v - p)
		formatString: #,0.00
		displayFolder: Contexto KPI
		lineageTag: 947c7799-1085-52ff-963c-768010c74536

	measure 'Variación (texto)' = VAR d = [Variación absoluta] VAR p = [Valor año anterior] VAR codigo = SELECTEDVALUE(dim_indicador[codigo_indicador]) VAR unidad = SELECTEDVALUE(dim_indicador[unidad]) VAR anterior = [Año del último valor] - 1 VAR flecha = IF(d > 0, "▲ ", IF(d < 0, "▼ ", "■ ")) VAR cifra = SWITCH(TRUE(), unidad IN {"porcentaje", "porcentaje_pib"}, FORMAT(d, "+0.0;-0.0;0.0") & " pp", codigo IN {"saldo_vegetativo", "saldo_migratorio_exterior"}, FORMAT(d, "+#,0;-#,0;0"), unidad IN {"hijos_por_mujer", "afiliados_por_pension", "anos"}, FORMAT(d, "+0.00;-0.00;0.00"), FORMAT(DIVIDE(d, ABS(p)), "+0.0%;-0.0%;0.0%")) RETURN IF(ISBLANK(d), "Sin dato del año anterior", flecha & cifra & " vs " & anterior)
		displayFolder: Contexto KPI
		lineageTag: 554f6cee-b77a-5988-8363-2ca4abb54fa4

	measure 'Lectura de la variación' = VAR d = [Variación absoluta] VAR s = SELECTEDVALUE(dim_indicador[sentido]) RETURN SWITCH(TRUE(), ISBLANK(d), BLANK(), d = 0 || s = "neutro", "neutral", (d > 0 && s = "mayor_es_mas_riesgo") || (d < 0 && s = "menor_es_mas_riesgo"), "desfavorable", "favorable")
		displayFolder: Contexto KPI
		lineageTag: d1ab9449-2d3a-5290-927a-aac9e52b1ed9

	measure 'Color de la variación' = SWITCH([Lectura de la variación], "desfavorable", "#CF222E", "favorable", "#1A7F37", "#57606A")
		displayFolder: Contexto KPI
		lineageTag: 538c4cbc-542f-5478-8185-6835ade355c4

	measure 'Estado del último valor' = VAR a = [Año del último valor] RETURN IF(CALCULATE(COUNTROWS(fact_indicadores_anual), dim_tiempo[tiempo_key] = a, fact_indicadores_anual[estado_dato] = "provisional", dim_sexo[codigo_sexo] = "total", dim_grupo_edad[codigo_grupo] = "total") > 0, "provisional", "definitivo")
		displayFolder: Contexto KPI
		lineageTag: 31114b5a-90f2-592a-9ffb-3c5a99a0b88d

	measure 'Fuente (corta)' = SWITCH(SELECTEDVALUE(dim_indicador[codigo_fuente]), "ine", "INE", "seguridad_social", "Seguridad Social", "eurostat", "Eurostat", "integrado", "INE + Seguridad Social", "")
		displayFolder: Contexto KPI
		lineageTag: 1b28b708-85ba-5299-8226-01781c6117f7

	measure 'Contexto del KPI' = VAR lectura = [Lectura de la variación] RETURN [Variación (texto)] & IF(ISBLANK(lectura) || lectura = "neutral", "", " (" & lectura & ")") & "  ·  dato " & [Año del último valor] & IF([Estado del último valor] = "provisional", " (provisional)", "") & "  ·  " & [Fuente (corta)]
		displayFolder: Contexto KPI
		lineageTag: bd03b6a1-d8a5-57e8-b5ee-8001d367a2b4

	measure 'Último valor (texto)' = VAR v = [Último valor] VAR u = SELECTEDVALUE(dim_indicador[unidad]) VAR codigo = SELECTEDVALUE(dim_indicador[codigo_indicador]) RETURN IF(ISBLANK(v), BLANK(), SWITCH(TRUE(), u IN {"porcentaje", "porcentaje_pib"}, FORMAT(v, "0.0") & " %", codigo IN {"saldo_vegetativo", "saldo_migratorio_exterior"}, FORMAT(v, "+#,0;-#,0"), u = "hijos_por_mujer", FORMAT(v, "0.00"), u = "afiliados_por_pension", FORMAT(v, "0.00"), u = "eur_mes", FORMAT(v, "#,0") & " €", FORMAT(v, "#,0.0")))
		displayFolder: Contexto KPI
		lineageTag: 0daa9fc7-d35a-5c48-88f9-09a2786e1dff

