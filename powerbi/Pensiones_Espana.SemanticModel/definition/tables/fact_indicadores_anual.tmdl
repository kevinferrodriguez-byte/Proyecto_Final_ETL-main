	measure 'Título · dependencia' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "tasa_dependencia_mayores", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "tasa_dependencia_mayores", ALLSELECTED(dim_tiempo)) VAR v0 = CALCULATE([KPI-03 Dependencia de mayores], dim_tiempo[tiempo_key] = a0) VAR v1 = CALCULATE([KPI-03 Dependencia de mayores], dim_tiempo[tiempo_key] = a1) RETURN "La dependencia de mayores " & IF(v1 >= 2 * v0, "se duplicó", IF(v1 >= 1.95 * v0, "prácticamente se duplicó", IF(v1 > v0, "aumentó", "bajó"))) & ": de " & FORMAT(v0, "0.0") & " % (" & a0 & ") a " & FORMAT(v1, "0.0") & " % (" & a1 & ")"
		displayFolder: Títulos
		lineageTag: 19601e99-da80-5bca-afc0-4398f95b32e7

	measure 'Título · estructura' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "porcentaje_mayores_65", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "porcentaje_mayores_65", ALLSELECTED(dim_tiempo)) VAR v0 = CALCULATE([% población 65+], dim_tiempo[tiempo_key] = a0) VAR v1 = CALCULATE([% población 65+], dim_tiempo[tiempo_key] = a1) RETURN "Las personas de 65+ pasan del " & FORMAT(v0, "0.0") & " % al " & FORMAT(v1, "0.0") & " % de la población (" & a0 & "–" & a1 & ")"
		displayFolder: Títulos
		lineageTag: 53211f93-57f5-59a2-8f77-cf326d1d8cad

	measure 'Título · fecundidad' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "indicador_coyuntural_fecundidad", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "indicador_coyuntural_fecundidad", ALLSELECTED(dim_tiempo)) VAR v1 = CALCULATE([KPI-04 Fecundidad (hijos por mujer)], dim_tiempo[tiempo_key] = a1) VAR vmin = CALCULATE(MIN(fact_indicadores_anual[valor]), dim_indicador[codigo_indicador] = "indicador_coyuntural_fecundidad", ALLSELECTED(dim_tiempo)) RETURN IF(v1 <= vmin, "La fecundidad marca su mínimo del periodo: ", "Fecundidad: ") & FORMAT(v1, "0.00") & " hijos por mujer en " & a1 & IF(v1 < 2.1, ", por debajo del reemplazo (2,1)", "")
		displayFolder: Títulos
		lineageTag: 108ee7da-207e-5b22-b805-5023ae4a46c7

	measure 'Título · saldo vegetativo' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "saldo_vegetativo", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "saldo_vegetativo", ALLSELECTED(dim_tiempo)) VAR v1 = CALCULATE([KPI-05 Saldo vegetativo], dim_tiempo[tiempo_key] = a1) VAR ultimoPositivo = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "saldo_vegetativo", fact_indicadores_anual[valor] > 0, ALLSELECTED(dim_tiempo)) RETURN IF(v1 >= 0, "Saldo vegetativo positivo en " & a1, IF(ISBLANK(ultimoPositivo), "Saldo vegetativo negativo en todo el periodo", "Saldo vegetativo negativo desde " & (ultimoPositivo + 1) & ": mueren más personas de las que nacen"))
		displayFolder: Títulos
		lineageTag: 693e8698-7204-5cea-a589-0fbf27e680eb

	measure 'Título · saldo migratorio' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "saldo_migratorio_exterior", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "saldo_migratorio_exterior", ALLSELECTED(dim_tiempo)) VAR v1 = CALCULATE([KPI-06 Saldo migratorio exterior], dim_tiempo[tiempo_key] = a1) RETURN "Saldo migratorio con el extranjero: " & FORMAT(v1, "+#,0;-#,0") & " en " & a1
		displayFolder: Títulos
		lineageTag: 5c72b11d-17f8-5091-9e64-2eaa3280bb7d

	measure 'Título · índice contributivo' = VAR a0 = [Año base contributivo] VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "total_pensiones", ALLSELECTED(dim_tiempo)) VAR ga = DIVIDE(CALCULATE([Afiliados a 31 de diciembre], dim_tiempo[tiempo_key] = a1), CALCULATE([Afiliados a 31 de diciembre], dim_tiempo[tiempo_key] = a0)) - 1 VAR gp = DIVIDE(CALCULATE([Pensiones contributivas], dim_tiempo[tiempo_key] = a1), CALCULATE([Pensiones contributivas], dim_tiempo[tiempo_key] = a0)) - 1 RETURN "Desde " & a0 & ", los afiliados " & IF(ga > gp, "crecen más que las pensiones", "no crecen más que las pensiones") & ": " & FORMAT(ga, "+0%;-0%") & " frente a " & FORMAT(gp, "+0%;-0%") & " (" & a1 & ")"
		displayFolder: Títulos
		lineageTag: 98cfda54-465d-51c3-bb84-07278242bb4d

	measure 'Título · ratio' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "ratio_cotizantes_pensionistas", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "ratio_cotizantes_pensionistas", ALLSELECTED(dim_tiempo)) VAR v0 = CALCULATE([KPI-07 Afiliados por pensión], dim_tiempo[tiempo_key] = a0) VAR v1 = CALCULATE([KPI-07 Afiliados por pensión], dim_tiempo[tiempo_key] = a1) RETURN "Afiliados por pensión: de " & FORMAT(v0, "0.00") & " (" & a0 & ") a " & FORMAT(v1, "0.00") & " (" & a1 & ")"
		displayFolder: Títulos
		lineageTag: 51ecf1d0-f66d-5eab-beb9-05267ff1dfa2

	measure 'Título · afiliación' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "tasa_afiliacion_16_64", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "tasa_afiliacion_16_64", ALLSELECTED(dim_tiempo)) VAR v1 = CALCULATE([Tasa de afiliación 16-64], dim_tiempo[tiempo_key] = a1) VAR vmax = CALCULATE(MAX(fact_indicadores_anual[valor]), dim_indicador[codigo_indicador] = "tasa_afiliacion_16_64", ALLSELECTED(dim_tiempo)) RETURN FORMAT(v1, "0.0") & " afiliados por cada 100 personas de 16-64 años en " & a1 & IF(v1 >= vmax, ": máximo del periodo", "")
		displayFolder: Títulos
		lineageTag: bbfbafa3-9697-5a95-9412-5c3456927897

	measure 'Título · esperanza de vida 65' = VAR a = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "esperanza_vida_65", ALLSELECTED(dim_tiempo)) VAR mujeres = CALCULATE([Esperanza de vida a los 65 (por sexo)], dim_sexo[codigo_sexo] = "mujeres", dim_tiempo[tiempo_key] = a) VAR hombres = CALCULATE([Esperanza de vida a los 65 (por sexo)], dim_sexo[codigo_sexo] = "hombres", dim_tiempo[tiempo_key] = a) RETURN "A los 65 años, las mujeres viven en promedio " & FORMAT(mujeres - hombres, "0.0") & " años más que los hombres (" & a & ")"
		displayFolder: Títulos
		lineageTag: 80d58dc8-1004-543e-9772-6e4077da4847

	measure 'Título · gasto' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "gasto_pensiones_pib", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "gasto_pensiones_pib", ALLSELECTED(dim_tiempo)) VAR v0 = CALCULATE([KPI-08 Gasto en pensiones % PIB], dim_tiempo[tiempo_key] = a0) VAR v1 = CALCULATE([KPI-08 Gasto en pensiones % PIB], dim_tiempo[tiempo_key] = a1) VAR vmax = CALCULATE(MAX(fact_indicadores_anual[valor]), dim_indicador[codigo_indicador] = "gasto_pensiones_pib", ALLSELECTED(dim_tiempo)) VAR amax = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "gasto_pensiones_pib", fact_indicadores_anual[valor] = vmax, ALLSELECTED(dim_tiempo)) RETURN "Gasto en pensiones: de " & FORMAT(v0, "0.0") & " % a " & FORMAT(v1, "0.0") & " % del PIB (" & a0 & "–" & a1 & ")" & IF(amax <> a1, "; máximo de " & FORMAT(vmax, "0.0") & " % en " & amax, "")
		displayFolder: Títulos
		lineageTag: ff925b4e-57df-51fd-a4e1-6e878f7c584c

	measure 'Título · índice financiero' = VAR a0 = [Año base financiero] VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "gasto_pensiones_pib", ALLSELECTED(dim_tiempo)) VAR gg = DIVIDE(CALCULATE([Gasto en pensiones (M€)], dim_tiempo[tiempo_key] = a1), CALCULATE([Gasto en pensiones (M€)], dim_tiempo[tiempo_key] = a0)) - 1 VAR gp = DIVIDE(CALCULATE([PIB (M€)], dim_tiempo[tiempo_key] = a1), CALCULATE([PIB (M€)], dim_tiempo[tiempo_key] = a0)) - 1 RETURN "Entre " & a0 & " y " & a1 & " el gasto en pensiones creció " & FORMAT(gg, "+0%;-0%") & " y el PIB " & FORMAT(gp, "+0%;-0%") & " (en euros corrientes)"
		displayFolder: Títulos
		lineageTag: 87bf0642-1468-50b5-a1cc-0a487a831281

	measure 'Título · dispersión' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "gasto_pensiones_pib", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "gasto_pensiones_pib", ALLSELECTED(dim_tiempo)) VAR r = [Correlación dependencia-gasto] RETURN "Más dependencia de mayores se asocia a más gasto/PIB: correlación de " & FORMAT(r, "0.00") & " (" & a0 & "–" & a1 & ")"
		displayFolder: Títulos
		lineageTag: 85de235c-5b70-5b05-a775-594cd7d52e33

	measure 'Título · pensión media' = VAR a0 = CALCULATE(MIN(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "pension_media_mensual", ALLSELECTED(dim_tiempo)) VAR a1 = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), dim_indicador[codigo_indicador] = "pension_media_mensual", ALLSELECTED(dim_tiempo)) VAR v0 = CALCULATE([Pensión media mensual (€)], dim_tiempo[tiempo_key] = a0) VAR v1 = CALCULATE([Pensión media mensual (€)], dim_tiempo[tiempo_key] = a1) RETURN "La pensión media pasa de " & FORMAT(v0, "#,0") & " € a " & FORMAT(v1, "#,0") & " € al mes (" & a0 & "–" & a1 & ", euros corrientes)"
		displayFolder: Títulos
		lineageTag: e3286529-0995-5511-ab50-d5d485b42dba

	measure 'Título · calidad' = [Reglas superadas] & " de " & [Reglas evaluadas] & " reglas de calidad superadas · " & [Reglas con advertencia] & " advertencias · " & [Reglas con falla] & " fallas"
		displayFolder: Títulos
		lineageTag: c778e6c0-90d9-53e4-bec9-0bfc07f05de1

