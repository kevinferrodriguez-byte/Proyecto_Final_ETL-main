	partition fact_indicadores_anual = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaCSV & "fact_indicadores_anual.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"tiempo_key", Int64.Type}, {"territorio_key", Int64.Type}, {"sexo_key", Int64.Type}, {"grupo_edad_key", Int64.Type}, {"indicador_key", Int64.Type}, {"fuente_key", Int64.Type}, {"valor", type number}, {"unidad", type text}, {"estado_dato", type text}, {"metodologia", type text}, {"dataset_origen", type text}, {"run_id_origen", type text}, {"gold_run_id", type text}, {"fecha_generacion", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

