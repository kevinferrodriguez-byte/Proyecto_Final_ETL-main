	measure 'Correlación dependencia-gasto' = VAR t = FILTER(ADDCOLUMNS(VALUES(dim_tiempo[anyo]), "@x", [KPI-03 Dependencia de mayores], "@y", [KPI-08 Gasto en pensiones % PIB]), NOT ISBLANK([@x]) && NOT ISBLANK([@y])) VAR mx = AVERAGEX(t, [@x]) VAR my = AVERAGEX(t, [@y]) RETURN DIVIDE(SUMX(t, ([@x] - mx) * ([@y] - my)), SQRT(SUMX(t, ([@x] - mx) ^ 2)) * SQRT(SUMX(t, ([@y] - my) ^ 2)))
		formatString: 0.00
		displayFolder: Contexto
		lineageTag: ee85ed0d-3afb-54df-8177-e89bc429ccab

	measure 'Año de los datos' = CALCULATE(MAX(fact_indicadores_anual[tiempo_key]), REMOVEFILTERS(dim_tiempo))
