table aux_calidad_reglas
	lineageTag: 7c97c62e-1d50-52fe-87c0-30b262ddac31

	measure 'Reglas evaluadas' = COUNTROWS(aux_calidad_reglas)
		formatString: #,0
		lineageTag: 33823af3-318e-5b5e-b1d9-3a0cd381d7a8

	measure 'Reglas superadas' = CALCULATE(COUNTROWS(aux_calidad_reglas), aux_calidad_reglas[resultado] = "cumple") + 0
		formatString: #,0
		lineageTag: 9147c374-d11a-57fe-b988-5543c6d8e834

	measure 'Reglas con falla' = CALCULATE(COUNTROWS(aux_calidad_reglas), aux_calidad_reglas[resultado] = "falla") + 0
		formatString: #,0
		lineageTag: b97e4223-3e7f-54e8-8764-aa8f39685da8

	measure 'Reglas con advertencia' = CALCULATE(COUNTROWS(aux_calidad_reglas), aux_calidad_reglas[resultado] = "advertencia") + 0
		formatString: #,0
		lineageTag: abe4f0aa-5d53-5e25-a189-0ec2d1ca615f

