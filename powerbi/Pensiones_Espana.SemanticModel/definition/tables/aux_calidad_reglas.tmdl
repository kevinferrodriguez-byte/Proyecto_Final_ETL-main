	partition aux_calidad_reglas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaCSV & "aux_calidad_reglas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"capa", type text}, {"run_id", type text}, {"regla", type text}, {"descripcion", type text}, {"resultado", type text}, {"n_detalles", Int64.Type}, {"detalle", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

